language js

// The patched `<Link>` (patches/react-router@*.patch) renders an absolute path ("/foo") once
// and reads the location only when clicked. A relative target ("edit", "?tab=x") resolves
// against the current location, so every such link re-renders on each navigation. Build
// targets with the URL helpers (`app/utils/urls.ts`, `<feature>-urls.ts`) instead.
or {
	JsxAttribute(name=`to`, initializer=$initializer) as $attr where {
		$initializer <: r"=\s*\"[^\"]*\"",
		$initializer <: not or {
			r"=\s*\"/[^\"]*\"",
			r"=\s*\"https?:[^\"]*\"",
			r"=\s*\"mailto:[^\"]*\""
		},
		register_diagnostic(span=$attr, message="Relative link target. Use an absolute path from a URL helper (`app/utils/urls.ts` or `<feature>-urls.ts`) so the link does not re-render on every navigation.", severity="error")
	},
	`$definition.href("", $_)` as $call where {
		register_diagnostic(span=$call, message="Search-param-only link target, it resolves against the current location. Pass the page path as the first argument so the link does not re-render on every navigation. If the link must stay on whichever page is open, suppress with `// biome-ignore lint/plugin: <reason>`.", severity="error")
	}
}
