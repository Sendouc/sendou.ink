---
import path from "node:path";
import type { FeatureDoc } from "../../../../../scripts/living-docs/document.ts";
import { routeAnchor } from "../../../../../scripts/living-docs/links.ts";
import { routePathHtml, viewHref } from "../../living/format.ts";
import FileLink from "./FileLink.astro";

interface Props {
	feature: FeatureDoc;
	coverage: FeatureDoc["routes"][number];
}

const { feature, coverage } = Astro.props;
const { route, visitedBy } = coverage;
const kind = route.isLayout
	? "layout"
	: route.hasComponent
		? "page"
		: "resource";
---

<article class="route">
	<header class="route-head">
		<h2 class="route-path" id={routeAnchor(route)}>
			<code set:html={routePathHtml(route.path)} />
		</h2>
		<span class="badge">{kind}{route.isIndex ? " · index" : ""}</span>
		{route.hasLoader ? <span class="badge badge-loader">loader</span> : null}
		{route.hasAction ? <span class="badge badge-action">action</span> : null}
		<FileLink file={route.file} line={1} label={path.basename(route.file)} />
	</header>
	{
		visitedBy.length > 0 ? (
			<ul class="route-tests">
				{visitedBy.map((test) => (
					<li>
						<a href={viewHref(test.featureId, "e2e", test.anchor)}>{test.name}</a>
					</li>
				))}
			</ul>
		) : feature.hasCapture ? (
			<p class="warn-text">No e2e test renders this route</p>
		) : null
	}
</article>
