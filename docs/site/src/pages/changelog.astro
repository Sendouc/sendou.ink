---
import { getCollection, render } from "astro:content";
import { Badge } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { STATIC_ASSETS_URL, sitePath } from "../living/format.ts";

const entries = await Promise.all(
	(await getCollection("changelog")).map(async (entry) => ({
		date: entry.id.slice(0, 10),
		type: entry.data.type,
		navItems: entry.data.navItem ? [entry.data.navItem].flat() : [],
		Content: (await render(entry)).Content,
	})),
);
const days = [...new Set(entries.map((entry) => entry.date))]
	.sort()
	.reverse()
	.map((date) => ({
		date,
		label: new Intl.DateTimeFormat("en-GB", {
			day: "numeric",
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(new Date(date)),
		entries: entries.filter((entry) => entry.date === date),
	}));
---

<StarlightPage
	frontmatter={{
		title: "What's new",
		description: "Every user facing change, from changelog/.",
		editUrl: false,
	}}
	headings={days.map((day) => ({ depth: 2, slug: day.date, text: day.label }))}
>
	<p>
		Every user facing change, from the entries in <code>changelog/</code>. See the{" "}
		<a href={sitePath("project/agent-instructions/#changelog")}>changelog conventions</a>.
	</p>
	{
		days.map((day) => (
			<>
				<h2 id={day.date}>{day.label}</h2>
				<ul class="changelog not-content">
					{day.entries.map(({ type, navItems, Content }) => (
						<li>
							<span class="changelog-icons">
								{navItems.length > 0 ? (
									navItems.map((icon) => (
										<img
											src={`${STATIC_ASSETS_URL}/img/layout/${icon}.avif`}
											alt=""
											width="24"
											height="24"
											loading="lazy"
										/>
									))
								) : (
									<img src={sitePath("favicon.ico")} alt="" width="24" height="24" />
								)}
							</span>
							<Badge
								text={type === "feature" ? "New" : "Fix"}
								variant={type === "feature" ? "success" : "caution"}
							/>
							<div class="changelog-body sl-markdown-content">
								<Content />
							</div>
						</li>
					))}
				</ul>
			</>
		))
	}
</StarlightPage>

<style>
	.changelog {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		margin-top: 1rem;

		& li {
			display: grid;
			grid-template-columns: auto auto minmax(0, 1fr);
			align-items: start;
			gap: 0.75rem;
		}
	}

	.changelog-icons {
		display: flex;
		gap: 0.25rem;
		min-width: 24px;
	}

	.changelog-body :global(p) {
		margin: 0;
	}
</style>
