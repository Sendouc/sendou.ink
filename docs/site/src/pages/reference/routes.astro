---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import {
	githubUrl,
	routeAnchor,
} from "../../../../../scripts/living-docs/links.ts";
import { count, routePathHtml, viewHref } from "../../living/format.ts";

const features = (await getCollection("features")).map((entry) => entry.data);
const routes = features
	.flatMap((feature) =>
		feature.routes.map((coverage) => ({ ...coverage, feature })),
	)
	.sort((a, b) => a.route.path.localeCompare(b.route.path));
const hasCapture = features.some((feature) => feature.hasCapture);
const pages = routes.filter(({ route }) => !route.isLayout);
const visitedPages = pages.filter(({ visitedBy }) => visitedBy.length > 0);
---

<StarlightPage
	frontmatter={{
		title: "Routes",
		description: "Every route of app/routes.ts and the e2e tests that render it.",
		editUrl: false,
	}}
>
	<p>
		Every route of <code>app/routes.ts</code>.{" "}
		{
			hasCapture ? (
				<>
					<strong>{visitedPages.length}</strong> of {count(pages.length, "page")} are rendered
					by an e2e test in the last <code>pnpm run docs:capture</code>.
				</>
			) : (
				<>
					Run <code>pnpm run docs:capture</code> to see which e2e tests render each one.
				</>
			)
		}
	</p>
	<table>
		<thead>
			<tr>
				<th>Path</th>
				<th>Feature</th>
				<th>Kind</th>
				{hasCapture ? <th>E2E tests</th> : null}
			</tr>
		</thead>
		<tbody>
			{
				routes.map(({ route, visitedBy, feature }) => (
					<tr>
						<td>
							<a href={githubUrl(route.file, 1)}>
								<code set:html={routePathHtml(route.path)} />
							</a>
						</td>
						<td>
							<a href={viewHref(feature.config.id, "routes", routeAnchor(route))}>
								{feature.config.label}
							</a>
						</td>
						<td>
							{[
								route.isLayout ? "layout" : route.hasComponent ? "page" : "resource",
								route.hasLoader ? "loader" : null,
								route.hasAction ? "action" : null,
							]
								.filter((kind) => kind !== null)
								.join(", ")}
						</td>
						{hasCapture ? (
							<td>
								{visitedBy.length > 0
									? count(visitedBy.length, "test")
									: route.isLayout
										? ""
										: "none"}
							</td>
						) : null}
					</tr>
				))
			}
		</tbody>
	</table>
</StarlightPage>
